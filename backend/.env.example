# GitHub JSON persistence — backend only (never expose this token to the browser)
GITHUB_DATA_OWNER=agroscan-lumitech
GITHUB_DATA_REPO=secure-json-database
GITHUB_DATA_BRANCH=main
GITHUB_DATA_TOKEN=

# Use a separate random secret for user session signing.
# Generate with: openssl rand -hex 32
USER_SESSION_SECRET=

# Exact browser origins allowed to call the API, comma-separated.
ALLOWED_ORIGINS=https://v1.agroscan.dpdns.org,https://v1-agroscan.netlify.app,https://agroscan-org.netlify.app,https://agroscan-dev.netlify.app

# Optional GitHub JSON cache duration in milliseconds.
JSON_CACHE_TTL_MS=60000

# AI provider settings (configure only the provider in use on Render).
AI_PROVIDER=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
