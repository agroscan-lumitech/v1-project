{
  "appName": "AgroScan",
  "version": "1.0.0",
  "backendDomain": "https://backend.v1.agroscan.dpdns.org",
  "endpoints": {
    "cookieExpiryDays": "/api/controls/cookie_expiry_days",
    "login": "/api/login",
    "signup": "/api/signup",
